{
  "name": "stag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "tsc --noEmit && cf build",
    "preview": "vite build && vite preview",
    "cf:deploy": "pnpm build && cf deploy --prebuilt",
    "cf:preview": "pnpm typecheck && cf previews deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay:update": "REPLAY_UPDATE=1 vitest run src/replay/fixtures.test.ts",
    "devlog:video": "node scripts/devlog-video.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky",
    "models:build": "node scripts/build-models.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/inspector": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "@preact/signals": "^2.11.2",
    "miniplex": "^2.0.0",
    "preact": "^10.29.8",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "1.62.4",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@preact/preset-vite": "^2.10.6",
    "@tweakpane/core": "2.0.5",
    "@types/node": "^26.6.3",
    "agent-browser": "^0.38.1",
    "cf": "1.0.0-beta.12",
    "husky": "^9.1.7",
    "sharp": "0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
