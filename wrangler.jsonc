// Static-assets-only Worker: no script, Cloudflare serves `dist/` (the Vite build) directly.
// Deployed by Workers Builds (main → production, other branches → Worker Previews); see AGENTS.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stag",
  "compatibility_date": "2026-09-27",
  "assets": { "directory": "./dist" },
  // Worker Previews (`wrangler preview`, run by Workers Builds for every non-main branch). Empty:
  // Previews inherit everything above.
  "previews": {},
  // Workers Logs + automatic tracing, everything sampled (traffic is tiny). Asset-only requests
  // never invoke a script, so these fill up once the Worker gets code (API, D1 in Phase 14).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
